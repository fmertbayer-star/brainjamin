rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // isAdmin: hybrid OR per BRAINJAMIN_CONTEXT.md § Security Model.
    // Custom claim (admin or isAdmin) OR users/{uid}.isAdmin == true.
    // exists() guard before get() to avoid permission errors on missing
    // user docs (anonymous users have no users/{uid} until first write).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.isAdmin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }

    // questions_public — global question pool.
    // Signed-in clients (incl. anonymous via Firebase Anonymous Auth)
    // read for Daily / Self-Test / Arena prefilled / Duel pools.
    // Writes are server-only (admin SDK in Cloud Functions).
    match /questions_public/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ai_config — server-only configuration (model names, prompt
    // templates). Never exposed to clients.
    match /ai_config/{docId} {
      allow read, write: if false;
    }

    // daily_questions — one daily question per dateKey.
    // Clients can read; writes are Cloud Functions only (admin SDK bypass).
    match /daily_questions/{dateKey} {
      allow read: if true;
      allow write: if false;
    }

    // daily_answers — per-user daily answer documents.
    // Read only own answer docs; writes are Cloud Functions only.
    match /daily_answers/{answerId} {
      allow read: if request.auth != null &&
        resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // used_questions — per-user seen-question history for dedup.
    // Read only own subtree; writes are Cloud Functions only.
    match /used_questions/{uid}/seen/{qId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'fcm_token',
          'fcm_token_updated_at',
          'pushPrimerCooldownUntil',
          'tutorialSeen',
          'profileNudgeHiddenUntil'
        ]);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fcm_token',
          'fcm_token_updated_at',
          'pushPrimerCooldownUntil',
          'tutorialSeen',
          'profileNudgeHiddenUntil'
        ]);
      allow delete: if false;
    }

    // self_test_sessions — per-session 25-Q Self-Test runs.
    // Created and updated by selectSelfTestQuestions / submitSelfTestSession
    // Cloud Functions only. Clients never read or write directly; the
    // session payload (questions, correct indices, answers) is returned
    // to the client through the callable, not via Firestore listen.
    match /self_test_sessions/{sessionId} {
      allow read, write: if false;
    }

    // users_public — denormalized public profile (displayName, xp,
    // level, country) for leaderboard display. Created lazily on
    // anonymous → permanent conversion by onUserConverted Cloud Function.
    // Sprint 5 (Profile + Ranking) will open client-side reads with a
    // separate match block at that time. Until then, no client access.
    match /users_public/{uid} {
      allow read, write: if false;
    }

    // self_test_leaderboard/{weekKey}/sessions/{sessionId} — weekly
    // Self-Test leaderboard entries. Written by submitSelfTestSession.
    // Sprint 5 (Leaderboard tab) will open client-side reads with an
    // ordered query when that surface ships. Until then, no client access.
    match /self_test_leaderboard/{weekKey}/sessions/{sessionId} {
      allow read, write: if false;
    }

    // reports — user-submitted question reports. Written exclusively
    // through the submitReport callable (transactional dedup +
    // dailyReports cap). Clients never read or write reports directly;
    // admin triage in V1 happens through Firebase Console.
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // =====================================================================
    // Duel (Sprint 3) — anonymous users allowed; all writes server-side via
    // createDuel / joinDuel / getDuelQuestions / submitDuelAnswers /
    // expireDuels Cloud Functions. Score calculation is server-authoritative.
    // =====================================================================

    match /duels/{duelId} {
      allow read: if request.auth != null &&
        (
          resource.data.player1_id == request.auth.uid ||
          (resource.data.player2_id != null && resource.data.player2_id == request.auth.uid)
        ) &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      // All writes go through createDuel / joinDuel / submitDuelAnswers /
      // expireDuels Cloud Functions.
      allow create, update, delete: if false;
    }

    match /duel_questions/{duelId}/q/{qIndex} {
      allow read: if request.auth != null &&
        (
          get(/databases/$(database)/documents/duels/$(duelId)).data.player1_id == request.auth.uid ||
          (get(/databases/$(database)/documents/duels/$(duelId)).data.player2_id != null && get(/databases/$(database)/documents/duels/$(duelId)).data.player2_id == request.auth.uid)
        ) &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow create, update, delete: if false;
    }

    match /duel_queue/{uid} {
      allow read: if request.auth != null &&
        request.auth.uid == uid &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow create, update, delete: if false;
    }

    // =====================================================================
    // Tournament / Live (Sprint 4.1) — reads for signed-in clients; all
    // writes via Admin SDK in Cloud Functions only.
    // =====================================================================

    match /tournaments/{tournamentId} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow create, update, delete: if false;
    }

    match /tournament_sessions/{sessionId} {
      allow read: if request.auth != null &&
        resource.data.uid == request.auth.uid &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow create, update, delete: if false;
    }

    match /live_tournaments/{ltId} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow create, update, delete: if false;
    }

    match /live_participants/{ltId}/users/{uid} {
      allow read: if request.auth != null &&
        request.auth.uid == uid &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow create, update, delete: if false;
    }

    // correctIndex is written server-side only at reveal; clients only see
    // it after reveal via listener snapshots.
    match /live_questions/{ltId}/q/{qIndex} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow create, update, delete: if false;
    }

    // Leaderboard docs — any signed-in (non-banned) user may read for UI.
    match /live_results/{ltId}/users/{uid} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow create, update, delete: if false;
    }

    match /category_rotation/{docId} {
      allow read, write: if false;
    }

    match /embeddings/{qId} {
      allow read, write: if false;
    }

    match /ai_cache/{docId} {
      allow read, write: if false;
    }

    match /tournament_leaderboards/{slotId} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow create, update, delete: if false;
    }

    // =====================================================================
    // Arena (Sprint 3.5a) — invite-code group quiz. Lobby is open to any
    // signed-in non-banned user (anyone with the invite code can view).
    // arena_questions: readable when arena is scheduled, running, or ended,
    // and caller is a participant. Writes are admin SDK only (tick + gen).
    // createArena / joinArena / generateArenaQuestions / runArenaTournament /
    // finalizeArenaTournament / submitArenaAnswers / expireArenas (when present).
    // =====================================================================

    match /arenas/{arenaId} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow write: if false;
    }

    match /arena_participants/{arenaId}/users/{uid} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow write: if false;
    }

    match /arena_questions/{arenaId}/q/{qIndex} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        ) &&
        (
          get(/databases/$(database)/documents/arenas/$(arenaId)).data.status == "scheduled" ||
          get(/databases/$(database)/documents/arenas/$(arenaId)).data.status == "running" ||
          get(/databases/$(database)/documents/arenas/$(arenaId)).data.status == "ended"
        ) &&
        exists(/databases/$(database)/documents/arena_participants/$(arenaId)/users/$(request.auth.uid));
      allow write: if false;
    }

    match /arena_results/{arenaId}/users/{uid} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow create, update, delete: if false;
    }

    match /arena_leaderboards/{arenaId} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow write: if false;
    }

    // Arena runtime config (limits, feature flags). Console / Admin SDK only.
    match /arena_config/{configId} {
      allow read: if request.auth != null &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
        );
      allow write: if false;
    }

    // achievements — per-user earned badges. Written by checkAchievements
    // Cloud Function (Admin SDK). Clients read own earned subcollection only.
    match /achievements/{uid} {
      allow read, write: if false;

      match /earned/{achievementId} {
        allow read: if request.auth != null &&
          request.auth.uid == uid &&
          (
            !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true
          );
        allow write: if false;
      }
    }

    // Default deny for every other path. Each new collection gets
    // its own match block when its feature ships.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
